// Automated-processing libraries — LOADABLE.
//
// The two rules the plan's activities point at. Each holds a Drools rule, base64-encoded in
// content.data, that the automated-processing service evaluates when a measurement is submitted.
//
// WHICH ACTIVITY USES WHICH. The saturation and pulse activities point at the absolute-range rule;
// the questionnaire activities point at the answer-significance rule. Containers and guidance
// activities point at neither, because they produce nothing to assess.
//
// BOTH RAISE A TASK ON EVERY OUTCOME, green included. The colour sets the priority — routine for
// green, urgent for yellow, asap for red — and the findings recorded, never whether a practitioner
// is asked to look. A measurement arriving with nothing to assess it against skips triage
// altogether and produces a bare routine task with no ClinicalImpression.
//
// IDENTIFIERS ARE NOT RE-MINTED here, unlike the plan, activity and questionnaire definitions.
// These rules are platform fixtures that a target environment is expected to hold already, so the
// identifier is the value the loader resolves them by rather than a fresh one.

Instance: library-observation-absolute-triage
InstanceOf: ehealth-library
Usage: #example
Title: "observation-absolute-range-triage"
Description: "Triages a submitted observation against absolute thresholds expressed in the observation's own unit. Reads the reference ranges from the observation it is given, so a measurement must carry them to be assessed; a GAL range yields a yellow assessment and a RAL range a red one."
* text.status = #additional
* text.div = "<div xmlns=\"http://www.w3.org/1999/xhtml\">Triagering af måling i forhold til absolutte grænseværdier.</div>"
* extension[0].url = "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-revision"
* extension[=].valueString = "0"
* extension[+].url = "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-modifier-role"
* extension[=].extension[0].url = "reference"
* extension[=].extension[=].valueReference = Reference(org-region-midtjylland)
* extension[=].extension[+].url = "role"
* extension[=].extension[=].valueCodeableConcept = $modifier-role#owner
* identifier.system = "urn:ietf:rfc:3986"
* identifier.value = "urn:uuid:63f0b086-f94d-4cbc-ab0e-f01eb6c27f43"
* version = "0"
* name = "observation-absolute-range-triage"
* title = "Måling Absolut Grænseværdier Triagering"
* status = #active
* experimental = true
* type = $library-type#automated-processing
// The eHealth jurisdiction value set holds legal acts, not countries — healthcare-act,
// service-act, elderly-act. Set it explicitly on every definitional resource, because anything
// left unset is filled in by the IG Publisher from the IG's own jurisdiction.
* jurisdiction = $jurisdiction#healthcare-act "Danish healthcare act"
* publisher = "Den telemedicinske infrastruktur (eHealth Infrastructure)"
* description = "Reglen triagerer en måling ved at sammenholde målte værdi med absolutte grænseværdi(er). En absolut grænseværdi er udtrykt i samme enhed som målingen. Eksempelvis kan en rød, absolut grænseværdi for iltmætning være anført som værdier under 88%, hvorved en målt iltmætning på 86% triagerer som en opgave med rød alarm."
* purpose = "Reglen benyttes til at afgøre hvordan en indsendt måling skal triageres."
* parameter[0].use = #in
* parameter[=].type = #Observation
* parameter[+].use = #in
* parameter[=].type = #ServiceRequest
* content.contentType = #text/plain
* content.data = ""

Instance: library-questionnaire-triage
InstanceOf: ehealth-library
Usage: #example
Title: "questionnaire-response-triage-on-answersignificance"
Description: "Triages a submitted questionnaire response by matching each answer against the answer-significance mappings on the questionnaire, and recording one finding basis per answered question alongside the overall assessment."
* extension[0].url = "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-revision"
* extension[=].valueString = "0"
* extension[+].url = "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-modifier-role"
* extension[=].extension[0].url = "reference"
* extension[=].extension[=].valueReference = Reference(org-region-midtjylland)
* extension[=].extension[+].url = "role"
* extension[=].extension[=].valueCodeableConcept = $modifier-role#owner
* identifier.system = "urn:ietf:rfc:3986"
* identifier.value = "urn:uuid:9971d2b2-dcf4-41f3-a0d9-a3051095254d"
* version = "0"
* name = "questionnaire-response-triage-on-answersignificance"
* title = "Spørgeskematriagering"
* status = #active
* experimental = true
* type = $library-type#automated-processing
* jurisdiction[0] = $jurisdiction#healthcare-act "Danish healthcare act"
* jurisdiction[+] = $jurisdiction#service-act "Danish service act"
* publisher = "Den telemedicinske infrastruktur (eHealth Infrastructure)"
* description = "Spørgeskematriagering triagerer besvarelserne i et spørgeskema. Triageringsfarven findes ved at se alle spørgsmålsbesvarelser, og den endelige triagering bliver den højest udslagsgivende farve. Således giver én rød besvarelse rød triagering, og hvis der ingen røde besvarelser er, men mindst en gul besvarelse, bliver triageringsfarven gul. Er der ingen røde eller gule besvarelser, bliver triageringsfarven grøn.

Er der indsendt spørgeskema hvor spørgsmålene ikke er besvaret er triageringsfarven blank. Er der ikke opsat traigeringsindikatorer i spørgeskemaet bliver triageringen blank."
* purpose = "At kunne triagere spørgeskemabesvarelser."
* usage = "At kunne triagere spørgeskemabesvarelser."
* parameter[0].use = #in
* parameter[=].type = #QuestionnaireResponse
* parameter[+].use = #in
* parameter[=].type = #Questionnaire
* parameter[+].use = #in
* parameter[=].type = #ServiceRequest
* content.contentType = #text/plain
* content.data = ""
